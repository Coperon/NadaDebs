# required: sanity studio project id
SANITY_STUDIO_PROJECT_ID="xxxxx"
# required: sanity studio dataset to use
SANITY_STUDIO_DATASET="production"
# Studio hostname, if used you won't need to choose hostname on sanity deploys
# Example: 'llos-starter' if your studio is hosted at 'https://llos-starter.sanity.studio'
SANITY_STUDIO_HOST=""
# this is ther url that will be used for content preview urls in the studio
SANITY_STUDIO_PREVIEW_URL="https://preview--your-site.dev"
# this is ther url that will be used when building the site
SANITY_STUDIO_PRODUCTION_URL="https://your-site.dev"

SANITY_STUDIO_SHOPIFY_DOMAIN="llos-xyz.myshopify.com"
# --- Netlify deploy widget (Studio dashboard "Deploy" button) ---
# These enable the manual deploy button in the Studio dashboard, which replaces
# the automatic publish-triggered webhook. Both are required for the widget in
# sanity.config.js to render. Neither is a secret.
#
# Netlify -> Site configuration -> General -> Site details -> Site ID
SANITY_STUDIO_NETLIFY_SITE_ID=""
# Netlify -> Site configuration -> Build & deploy -> Build hooks
# Use ONLY the last path segment of the hook URL, not the full URL.
# e.g. for https://api.netlify.com/build_hooks/abc123  ->  use "abc123"
SANITY_STUDIO_NETLIFY_BUILD_HOOK_ID=""
